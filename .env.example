# ---- Supabase (required for authentication, learning platform, admin) ----
# Project URL and anon (public) key from Supabase → Project Settings → API.
# The anon key is safe to ship to the browser: all access is governed by RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public site URL (used for canonical links, sitemap, certificate QR codes)
VITE_SITE_URL=https://mcsli.org

# ---- Server-side only (never prefix with VITE_, never commit real values) ----
# Used by scripts/db-apply.mjs and the db integration tests.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/mcsli_test

# Supabase Edge Functions read these from `supabase secrets set`, not from this file:
# SUPABASE_SERVICE_ROLE_KEY=...   (only inside Edge Functions)
