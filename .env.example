# Copy to .env.local (git-ignored). Placeholders only – never commit real values.

# ---- Browser (public) -------------------------------------------------------
# Supabase → Project Settings → API. The anon key is safe to ship: all access is governed by RLS.
# Local stack: values from `npx supabase status` (API URL / anon key).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public site URL: auth e-mail redirects (/login, /reset-password), canonical links, certificate QR codes.
# Local: http://localhost:5173 · Production: https://mcsli.org (or https://learn.mcsli.org)
VITE_SITE_URL=https://mcsli.org

# ---- Server-side only (never prefix with VITE_, never commit real values) ----
# Scripts and tests; pass on the command line for one-off use rather than storing them here.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres        # local stack
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/mcsli_test           # disposable test DB
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY – only for scripts/e2e-supabase.mjs against staging.
# Edge Functions receive SUPABASE_SERVICE_ROLE_KEY from the platform automatically.
